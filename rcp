#!/usr/bin/env bash

# Technical Justification:
# 1. External 'rsync' is the core dependency and unavoidable.
# 2. 'mkdir' is used only if the target directory does not exist to minimize forks.
# 3. Version-aware progress flag is removed to eliminate the triple-fork pipeline.
#    Standard --progress is used as a safe, cross-version fallback.

_ssh_port=8022

# Parse options
while getopts ":p:h" _opt; do
    case "${_opt}" in
    p) _ssh_port="${OPTARG}" ;;
    *)
        printf "Usage: %s [-p PORT] <from> <to>\n" "${0##*/}" >&2
        exit 1
        ;;
    esac
done
shift $((OPTIND - 1))

_from="$1"
_target="$2"

# Validate input
if [[ -z "${_from}" || -z "${_target}" ]]; then
    printf "Usage: %s [-p PORT] <from> <to>\n" "${0##*/}" >&2
    exit 1
fi

# Ensure target exists; guard to avoid fork if already present
if [[ ! -d "${_target}" ]]; then
    mkdir -p "${_target}" || {
        printf "Error: Failed to create directory %s\n" "${_target}" >&2
        exit 1
    }
fi

printf "Syncing: %s -> %s\n" "${_from}" "${_target}"

# Base rsync arguments
_args=(-a --partial --progress)

# Add SSH configuration if remote source
if [[ "${_from}" == *:* ]]; then
    _args+=(-e "ssh -p ${_ssh_port}")
fi

# Run rsync
rsync "${_args[@]}" "${_from}/" "${_target}/" || {
    printf "Error: rsync failed for %s\n" "${_from}" >&2
    exit 1
}
